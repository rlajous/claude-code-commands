---
import Badge from './ui/Badge.astro';
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';
import CardContent from './ui/CardContent.astro';
import CardHeader from './ui/CardHeader.astro';
import IconGlyph from './ui/IconGlyph.astro';
import Item from './ui/Item.astro';
import Kbd from './ui/Kbd.astro';
import NotificationStage from './NotificationStage.astro';
import TabPanel from './ui/TabPanel.astro';
import Tabs from './ui/Tabs.astro';

const version = import.meta.env.PUBLIC_GIT_WORKFLOW_VERSION;
const skillCount = import.meta.env.PUBLIC_GIT_WORKFLOW_SKILL_COUNT;
const agentCount = import.meta.env.PUBLIC_GIT_WORKFLOW_AGENT_COUNT;

const capabilityGroups = [
  {
    index: '01',
    title: 'Shape the change',
    skills: '$start · $tdd · $commit · $finish',
    detail: 'Turn an issue into a reviewable pull request while preserving each repository’s conventions.',
  },
  {
    index: '02',
    title: 'Prove the change',
    skills: '$review · $review-watch · $change-brief',
    detail: 'Combine deterministic checks, specialist review, and evidence a human can absorb quickly.',
  },
  {
    index: '03',
    title: 'Deliver the change',
    skills: '$release · $release-notes · $sync',
    detail: 'Validate releases, explain what shipped, and keep long-lived branches synchronized.',
  },
  {
    index: '04',
    title: 'Stay in the loop',
    skills: '$notifications · $status · $standup',
    detail: 'Receive private local signals and always know what happened and what comes next.',
  },
];

const workflow = [
  ['start', 'Issue → branch'],
  ['commit', 'Diff → history'],
  ['finish', 'Branch → PR'],
  ['review', 'Evidence → decision'],
  ['release', 'Change → users'],
];
---

<div class="hub-landing">
  <section class="product-hero" aria-labelledby="hub-title">
    <div class="hero-message">
      <div class="hero-kicker">
        <span class="hero-version"><span class="status-dot"></span>Git Workflow v{version}</span>
        <span class="hero-hosts">Claude Code <i aria-hidden="true">/</i> Codex</span>
      </div>
      <h1 id="hub-title">
        <span class="hero-line">Ship software</span>
        <span class="hero-line">with agents.</span>
        <span class="hero-line hero-line-accent">Keep decisions</span>
        <span class="hero-line hero-line-accent">human.</span>
      </h1>
      <p>From issue to release, give your agent a workflow it can follow—and your team evidence it can trust.</p>
      <div class="hero-actions">
        <Button href="/git-workflow/installation/">Install Git Workflow <IconGlyph name="arrow-right" /></Button>
        <Button href="https://github.com/rlajous/claude-code-commands" variant="outline">
          <IconGlyph name="github" /> View on GitHub
        </Button>
      </div>
      <p class="hero-assurance">
        <IconGlyph name="check" size={14} />
        Host-neutral core <span aria-hidden="true">·</span> {skillCount} skills <span aria-hidden="true">·</span> MIT licensed
      </p>
    </div>

    <div class="hero-visual">
      <div class="product-playground" aria-label="Git Workflow product preview">
        <div class="playground-toolbar">
          <div class="window-controls" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="runtime-intake" aria-label="Claude Code and Codex use one shared workflow">
            <span><code>/</code><b>Claude Code</b></span>
            <span class="runtime-path"><i aria-hidden="true">→</i><strong>One shared workflow</strong><i aria-hidden="true">←</i></span>
            <span><code>$</code><b>Codex</b></span>
          </div>
          <Badge variant="success">live</Badge>
        </div>

        <div class="playground-grid">
          <Card class="status-card" elevated>
            <CardHeader>
              <div>
                <p class="card-label">Pipeline status</p>
                <h2>Ready for review</h2>
              </div>
              <span class="status-icon"><IconGlyph name="check" /></span>
            </CardHeader>
            <CardContent>
              <div class="branch-row"><code>feat/codex-support</code><Badge variant="outline">PR #29</Badge></div>
              <ol class="mini-workflow" aria-label="Workflow progress">
                {workflow.map(([step], index) => (
                  <li class:list={{ done: index < 4, current: index === 3 }}>
                    <span><IconGlyph name={index < 4 ? 'check' : 'spark'} size={12} /></span>
                    <small>{step}</small>
                  </li>
                ))}
              </ol>
            </CardContent>
          </Card>

          <Card class="review-card">
            <CardHeader>
              <div class="review-avatar" aria-hidden="true">RN</div>
              <div><p class="card-label">Review decision</p><h2>Approved</h2></div>
              <Badge variant="success"><IconGlyph name="check" size={12} /> clean</Badge>
            </CardHeader>
            <CardContent>
              <p>Deterministic checks passed. The implementation preserves Claude and Codex compatibility.</p>
              <div class="review-meta"><span>{agentCount} agents</span><span>0 findings</span><span>4m 12s</span></div>
            </CardContent>
          </Card>

          <Card class="terminal-card">
            <CardHeader>
              <div><p class="card-label">Next command</p><h2>Continue the workflow</h2></div>
              <Kbd>⌘ K</Kbd>
            </CardHeader>
            <CardContent>
              <div class="terminal-line"><span>›</span><code>$finish</code><span class="terminal-cursor"></span></div>
              <p>Create the pull request with repository context and validation evidence.</p>
            </CardContent>
          </Card>

          <Card class="signal-card">
            <CardHeader>
              <div><p class="card-label">Human checkpoint</p><h2>Review approved</h2></div>
              <span class="signal-mark"><IconGlyph name="spark" /></span>
            </CardHeader>
            <CardContent>
              <strong>rlajous/claude-code-commands · PR #29</strong>
              <p>@reviewer approved — Redesign Agent Tooling documentation UI</p>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <section id="install" class="quick-start" aria-labelledby="install-title" data-reveal>
    <div class="section-copy">
      <Badge variant="outline">Quick start</Badge>
      <h2 id="install-title">Same workflow.<br />Native in each host.</h2>
      <p>Install once, then use the syntax your agent already understands. The workflow and bundled resources stay identical.</p>
      <a href="/git-workflow/installation/">Read the installation guide <IconGlyph name="arrow-right" size={14} /></a>
    </div>

    <Tabs id="host-install" label="Installation host" tabs={[{ id: 'claude', label: 'Claude Code' }, { id: 'codex', label: 'Codex' }]}>
      <TabPanel tabsId="host-install" tab="claude" active>
        <div class="command-heading"><span><IconGlyph name="terminal" />Terminal</span><Badge variant="muted">Marketplace</Badge></div>
        <pre><code id="claude-install">/plugin marketplace add rlajous/claude-code-commands
/plugin install git-workflow@git-workflow-marketplace

/git-workflow:status</code></pre>
        <button class="copy-command" type="button" data-copy-target="claude-install" aria-label="Copy Claude Code installation commands">
          <IconGlyph name="clipboard" /><span aria-live="polite">Copy</span>
        </button>
      </TabPanel>
      <TabPanel tabsId="host-install" tab="codex">
        <div class="command-heading"><span><IconGlyph name="terminal" />Codex</span><Badge variant="muted">Plugin or checkout</Badge></div>
        <pre><code id="codex-install"># Configure the project
$setup

# Ask for the next workflow step
$status</code></pre>
        <button class="copy-command" type="button" data-copy-target="codex-install" aria-label="Copy Codex setup commands">
          <IconGlyph name="clipboard" /><span aria-live="polite">Copy</span>
        </button>
      </TabPanel>
      <p class="install-note">Use the installed plugin or checkout-local discovery in one session, not both.</p>
    </Tabs>
  </section>

  <section id="workflow" class="workflow-section" aria-labelledby="workflow-title">
    <header class="section-heading" data-reveal>
      <div><Badge variant="outline">A visible delivery loop</Badge><h2 id="workflow-title">Every step leaves proof.</h2></div>
      <p>Branches, commits, pull requests, review decisions, and releases remain inspectable instead of disappearing inside an agent session.</p>
    </header>
    <ol class="workflow-track" data-reveal>
      {workflow.map(([step, output], index) => (
        <li class:list={{ emphasized: step === 'review' }}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <div><strong>{step}</strong><small>{output}</small></div>
          {index < workflow.length - 1 && <IconGlyph name="chevron-right" />}
        </li>
      ))}
    </ol>
  </section>

  <section id="evidence" class="evidence-section" aria-labelledby="evidence-title">
    <header class="section-heading" data-reveal>
      <div><Badge variant="outline">Evidence, not ceremony</Badge><h2 id="evidence-title">Signals a human can act on.</h2></div>
      <p>Local notifications identify the repository, pull request, and person. Decision briefs turn a clean review into business logic, risks, diagrams, and proof.</p>
    </header>
    <div class="evidence-layout" data-reveal>
      <NotificationStage />
      <a class="brief-preview" href="/git-workflow/examples/pr-23/">
        <div class="brief-browser"><span></span><span></span><span></span><code>decision-brief / PR #23</code></div>
        <img src="/assets/change-brief-pr-23-960.webp" srcset="/assets/change-brief-pr-23-480.webp 480w, /assets/change-brief-pr-23-960.webp 960w, /assets/change-brief-pr-23-1440.webp 1440w" sizes="(max-width: 50rem) calc(100vw - 2rem), 44rem" alt="A Git Workflow decision brief with summary, business rules, workflow diagram, and notification evidence." loading="lazy" decoding="async" width="1440" height="2400" />
        <span>Open the real PR #23 decision brief <IconGlyph name="arrow-right" /></span>
      </a>
    </div>
  </section>

  <section id="capabilities" class="capabilities-section" aria-labelledby="capabilities-title">
    <header class="section-heading" data-reveal>
      <div><Badge variant="outline">{skillCount} shared skills</Badge><h2 id="capabilities-title">One operating model, end to end.</h2></div>
      <p>Use a single skill for the next task or let the workflow carry context across the full delivery loop.</p>
    </header>
    <div class="capability-list" data-reveal>
      {capabilityGroups.map((group) => (
        <Item index={group.index}>
          <div class="capability-title"><h3>{group.title}</h3><code>{group.skills}</code></div>
          <p>{group.detail}</p>
          <a slot="aside" href="/git-workflow/reference/commands/" aria-label={`Explore commands for ${group.title}`}><IconGlyph name="arrow-right" /></a>
        </Item>
      ))}
    </div>
  </section>

  <section class="closing-call" aria-labelledby="closing-title" data-reveal>
    <Badge variant="secondary">Open source · MIT licensed</Badge>
    <h2 id="closing-title">Make your repository legible to your agent.</h2>
    <p>Start with the next real change. Keep the evidence, review decisions, and release history yours.</p>
    <div>
      <Button href="/git-workflow/installation/">Install Git Workflow <IconGlyph name="arrow-right" /></Button>
      <Button href="/git-workflow/reference/commands/" variant="ghost">Explore every command</Button>
    </div>
  </section>
</div>

<script>
  /** Initialize idempotent copy feedback and one-time reduced-motion-safe reveals. */
  const initializeHubInteractions = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-target]').forEach((button) => {
      if (button.dataset.initialized === 'true') return;
      button.dataset.initialized = 'true';
      const initialLabel = button.getAttribute('aria-label') ?? 'Copy commands';

      button.addEventListener('click', async () => {
        const target = button.dataset.copyTarget ? document.getElementById(button.dataset.copyTarget) : null;
        const label = button.querySelector<HTMLElement>('span[aria-live]');
        if (!target || !label) return;

        try {
          await navigator.clipboard.writeText(target.textContent ?? '');
          label.textContent = 'Copied';
          button.dataset.copyState = 'success';
          button.setAttribute('aria-label', `${initialLabel}. Copied`);
        } catch {
          label.textContent = 'Try again';
          button.dataset.copyState = 'error';
          button.setAttribute('aria-label', `${initialLabel}. Copy failed`);
        }

        window.setTimeout(() => {
          label.textContent = 'Copy';
          button.setAttribute('aria-label', initialLabel);
          delete button.dataset.copyState;
        }, 1800);
      });
    });

    const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    if (revealItems.length === 0) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion || !('IntersectionObserver' in window)) {
      revealItems.forEach((item) => { item.dataset.revealState = 'visible'; });
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const item = entry.target as HTMLElement;
        item.dataset.revealState = 'visible';
        observer.unobserve(item);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });

    revealItems.forEach((item) => {
      if (item.dataset.revealState === 'visible') return;
      item.dataset.revealState = 'pending';
      observer.observe(item);
    });
  };

  initializeHubInteractions();
  document.addEventListener('astro:page-load', initializeHubInteractions);
</script>
