---
type IconName = 'arrow-right' | 'check' | 'chevron-right' | 'clipboard' | 'github' | 'menu' | 'moon' | 'spark' | 'sun' | 'terminal';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 16 } = Astro.props;
const paths: Record<IconName, string> = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="m5 12 4 4L19 6"/>',
  'chevron-right': '<path d="m9 18 6-6-6-6"/>',
  clipboard: '<rect width="14" height="16" x="5" y="4" rx="2"/><path d="M9 4V2h6v2M9 9h6M9 13h4"/>',
  github: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-6 0C5.8.1 4.7.5 4.7.5A5 5 0 0 0 4.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.6 6.8 7A4.8 4.8 0 0 0 9 18v4M9 19c-3 .9-3-1.5-4.2-2"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  moon: '<path d="M20.5 14.5A8.4 8.4 0 0 1 9.5 3.5 8.5 8.5 0 1 0 20.5 14.5Z"/>',
  spark: '<path d="m12 3-1.3 4.2a5 5 0 0 1-3.5 3.5L3 12l4.2 1.3a5 5 0 0 1 3.5 3.5L12 21l1.3-4.2a5 5 0 0 1 3.5-3.5L21 12l-4.2-1.3a5 5 0 0 1-3.5-3.5Z"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"/>',
  terminal: '<path d="m4 17 6-5-6-5M12 19h8"/>',
};
---

<svg
  data-slot="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
