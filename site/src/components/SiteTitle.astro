---
import BrandMark from './BrandMark.astro';
---

<a class="site-wordmark" href="/" aria-label="Agent Tooling home">
  <BrandMark class="site-wordmark__mark" />
  <span>Agent Tooling</span>
</a>

<style>
  .site-wordmark {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.7rem;
    color: var(--foreground);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    text-decoration: none;
  }

  .site-wordmark__mark {
    width: 1.75rem;
    height: 1.75rem;
  }
</style>
