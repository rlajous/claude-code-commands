{
  "name": "git-workflow-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run sync:content && astro dev",
    "sync:content": "node scripts/sync-content.mjs",
    "check": "npm run sync:content && npm run test:notification-assets && astro check",
    "build": "npm run sync:content && npm run test:notification-assets && astro build && node scripts/postbuild.mjs",
    "test": "npm run build && npm run test:dev-route && playwright test",
    "test:dev-route": "npm run sync:content && node scripts/test-dev-route.mjs",
    "test:site": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:notification-assets": "node scripts/validate-notification-assets.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/starlight": "0.41.9",
    "astro": "7.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "typescript": "5.9.3"
  }
}
