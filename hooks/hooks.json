{
  "description": "Git Workflow — optional background review and desktop notifications",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/hooks/review-commit.sh\" --host codex",
            "timeout": 120,
            "statusMessage": "Checking whether the new commit needs review"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/skills/notifications/scripts/agent-complete.py\" --host codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
